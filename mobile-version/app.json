{
  "expo": {
    "name": "Hookupapp1",
    "slug": "hookup-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "scheme": [
      "hookup",
      "app.hookup.mobile",
      "com.googleusercontent.apps.20879117427-c0j7dsqd3i4nq8p0rui118536di5aqr5"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hookup.mobile",
      "buildNumber": "13",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Hookup uses your location to show people nearby and to send a safety signal.",
        "NSCameraUsageDescription": "Hookup uses the camera for your profile photo and posts.",
        "NSPhotoLibraryUsageDescription": "Hookup uses your photos and videos for your profile and posts.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.social-networking"
      }
    },
    "android": {
      "package": "app.hookup.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hookup uses your location to show people nearby and to send a safety signal."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hookup uses your photos and videos for your profile and posts.",
          "cameraPermission": "Hookup uses the camera for your profile photo and posts."
        }
      ],
      "expo-web-browser",
      "expo-router",
      "expo-video"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7f024715-d643-4733-acef-34a309e3b6e8"
      },
      "contentRating": {
        "apple": "17+",
        "googlePlay": "Mature 17+",
        "userGeneratedContent": true,
        "reason": "Users can post photos and videos"
      }
    },
    "owner": "hookupapp1"
  }
}
