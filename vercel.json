{
  "version": 2,
  "buildCommand": "npm run install:all && cd client && npm run build:skip-typecheck",
  "outputDirectory": "client/dist",
  "framework": null,
  "installCommand": "npm install",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/p/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
