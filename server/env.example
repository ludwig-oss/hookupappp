PORT=5000
# Required in production (min 32 characters). Use a long random string.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
FRONTEND_URL=http://localhost:5173

# PostgreSQL (optional). When set, users, Love Life posts, and chat use the database instead of JSON files.
# On Render: create a PostgreSQL instance and add its Internal URL here as DATABASE_URL.
# Local dev (after: npm run db:up)
DATABASE_URL=postgresql://aswp:aswp_local_dev@localhost:5432/aswp

# Photos storage (optional). When set, profile/highlight/disappearing images upload to Cloudinary; otherwise base64 in DB.
# Get from https://cloudinary.com/console
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal Multiparty (Commerce Platform) — never commit real secrets.
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_SANDBOX=true
# Partner merchant id in PayPal + BN code (PayPal-Partner-Attribution-Id)
PAYPAL_PARTNER_ID=your_paypal_partner_merchant_id
PAYPAL_BN_CODE=your_paypal_bn_code

# WebAuthn / Face ID / Touch ID passkeys
# WEBAUTHN_RP_ID=hookupappp.vercel.app
# WEBAUTHN_ORIGIN=https://hookupappp.vercel.app
# WEBAUTHN_RP_NAME=ASWP

# Email verification – REQUIRED for real verification emails
# Copy this file to .env and set your real values. Without these, verification codes
# are only shown in the server console and do NOT go to the user's inbox.
# Use no spaces around = (e.g. SMTP_USER=my@gmail.com not SMTP_USER = my@gmail.com).
# Gmail: use an App Password (not your normal password). Create one at:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
# For Gmail, leave SMTP_FROM empty or same as SMTP_USER so mail is accepted
SMTP_FROM=

# SMS (Twilio) – optional. Without these, verification/reset codes by phone only show in server console.
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google OAuth – https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:
#   https://YOUR_VERCEL_DOMAIN/api/auth/google/callback
#   (or https://hookupappp.onrender.com/api/auth/google/callback if OAUTH_CALLBACK_BASE is Render)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login – https://developers.facebook.com/apps
# Valid OAuth Redirect URI:
#   https://YOUR_VERCEL_DOMAIN/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple Sign-In (optional)
# APPLE_CLIENT_ID=com.yourapp.service
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional: public base URL used as OAuth redirect_uri host (defaults to FRONTEND_URL)
# OAUTH_CALLBACK_BASE=https://hookupappp.vercel.app

# Web Push (optional). For push notifications (new message, new match). Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_MAILTO=mailto:your@email.com
