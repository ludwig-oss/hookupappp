{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "BACKEND_URL": "https://hookupappp.onrender.com"
  },
  "framework": null,
  "regions": ["fra1"],
  "installCommand": "npm run vercel-install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 10
    },
    "api/oauth-google-form.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/auth/oauth-return/google", "methods": ["POST"], "dest": "/api/oauth-google-form.js" },
    { "src": "/api/(.*)", "dest": "/api/[...path].js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "geolocation=*, camera=*, microphone=*" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "x-vercel-skip-toolbar", "value": "1" }
      ]
    }
  ]
}
