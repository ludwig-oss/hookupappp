# Copy to server/.env and fill in values

JWT_SECRET=your-long-random-secret-min-32-chars

# 32-byte key for encrypting ID images & safety videos at rest (hex 64 chars or base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_VAULT_KEY=

# Comma-separated user IDs who can open /admin/safety review
ADMIN_USER_IDS=

# Optional: header x-admin-secret for admin API (automation)
ADMIN_SECRET=

# Optional: Cloudinary for public media (not used for ID vault)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional virtual try-on (outfit desk). First match wins:
# custom GPU worker, FASHN, then Replicate IDM-VTON.
VTON_API_URL=
VTON_API_KEY=
FASHN_API_KEY=
REPLICATE_API_TOKEN=

# Optional appearance after-results (Elena face desk). Custom InstantID/ControlNet
# worker first, then Replicate Flux img2img. Canvas preview always works.
APPEARANCE_GEN_URL=
APPEARANCE_GEN_KEY=

# One-time AI crew help (outfit / face / TermAct). 100% to the app account.
# First 5 helps free; then Plus/Gold/Platinum or this fee each time.
AI_HELP_PRICE_EUR=9.9

# Stripe — keep secrets only in .env (never commit)
STRIPE_SECRET_KEY=
