# Copy to server/.env and fill in values

JWT_SECRET=your-long-random-secret-min-32-chars

# 32-byte key for encrypting ID images & safety videos at rest (hex 64 chars or base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ID_VAULT_KEY=

# Comma-separated user IDs who can open /admin/safety review
ADMIN_USER_IDS=

# Optional: header x-admin-secret for admin API (automation)
ADMIN_SECRET=

# Optional: Cloudinary for public media (not used for ID vault)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
